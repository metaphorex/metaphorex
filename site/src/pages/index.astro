---
import Base from "@/layouts/Base.astro";
import { getCollection } from "astro:content";

const entries = await getCollection("entries");
const frames = await getCollection("frames");
const categories = await getCollection("categories");
const works = await getCollection("works");

const notable = [...entries]
  .filter((e) => e.data.notable)
  .sort((a, b) => b.data.created.getTime() - a.data.created.getTime())
  .slice(0, 10);

const recent = [...entries]
  .sort((a, b) => b.data.created.getTime() - a.data.created.getTime())
  .slice(0, 10);

const recentWorks = [...works]
  .sort((a, b) => b.data.created.getTime() - a.data.created.getTime())
  .slice(0, 5);
---

<Base title="Home">
  <h1>Metaphorex</h1>
  <p>A materials library of load-bearing metaphors and other useful abstractions.</p>

  <h2>Corpus</h2>
  <p>
    <strong>{entries.length}</strong> entries &middot;
    <strong>{frames.length}</strong> frames &middot;
    <strong>{categories.length}</strong> categories &middot;
    <strong>{works.length}</strong> works
  </p>

  <h2>Browse</h2>
  <ul>
    <li><a href="/entries/">All entries</a> — metaphors, patterns, mental models, archetypes</li>
    <li><a href="/frames/">All frames</a> — source and target domains</li>
    <li><a href="/categories/">All categories</a> — cross-cutting taxonomy</li>
    <li><a href="/works/">All works</a> — source texts and collections</li>
  </ul>

  <h2>Recently Imported Works</h2>
  <ul class="entry-list">
    {recentWorks.map((w) => (
      <li>
        <a href={`/works/${w.data.slug}/`}>{w.data.name}</a>
        <span class="muted"> — {w.data.authors.join(", ")} ({w.data.year})</span>
      </li>
    ))}
  </ul>

  {notable.length > 0 ? (
    <>
      <h2>New and Notable</h2>
      <ul class="entry-list">
        {notable.map((m) => (
          <li>
            <a href={`/entries/${m.data.slug}/`}>{m.data.name}</a>
            {m.data.notable_quote && (
              <span class="muted"> — "{m.data.notable_quote}"</span>
            )}
          </li>
        ))}
      </ul>
    </>
  ) : (
    <>
      <h2>Latest Entries</h2>
      <ul class="entry-list">
        {recent.map((m) => (
          <li>
            <a href={`/entries/${m.data.slug}/`}>{m.data.name}</a>
            <span class="muted"> — {m.data.kind}</span>
          </li>
        ))}
      </ul>
    </>
  )}
</Base>
