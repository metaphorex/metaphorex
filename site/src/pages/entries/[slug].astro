---
import Base from "@/layouts/Base.astro";
import { getCollection, render } from "astro:content";
import neighborsData from "@/data/neighbors.json";

export async function getStaticPaths() {
  const entries = await getCollection("entries");
  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const allFrames = await getCollection("frames");
const sourceFrame = entry.data.source_frame
  ? allFrames.find((f) => f.data.slug === entry.data.source_frame)
  : null;
const appliesTo = (entry.data.applies_to || []).map((slug: string) => {
  const frame = allFrames.find((f) => f.data.slug === slug);
  return { slug, frame };
});

const allEntries = await getCollection("entries");
const related = entry.data.related
  .map((slug: string) => allEntries.find((m) => m.data.slug === slug))
  .filter(Boolean);

const allWorks = await getCollection("works");
const provenanceWork = entry.data.provenance
  ? allWorks.find((w) => w.data.slug === entry.data.provenance)
  : null;

// Structural neighbors (pre-computed at build time)
const entryNeighbors = (neighborsData as any)[entry.data.slug];
const crossDomain = entryNeighbors?.crossDomain ?? [];
const sameDomain = entryNeighbors?.sameDomain ?? [];

// Structural tags for display
const ep = entry.data.embodied_patterns ?? [];
const rt = entry.data.relation_types ?? [];
const st = entry.data.structure;
const stList = st ? (Array.isArray(st) ? st : [st]) : [];
const al = entry.data.abstraction_level;

function descriptionText() {
  const parts: string[] = [entry.data.name];
  if (sourceFrame) parts.push(`from ${sourceFrame.data.name}`);
  if (appliesTo.length > 0) parts.push(`applied to ${appliesTo.map((a: { slug: string; frame: any }) => a.frame?.data.name || a.slug).join(", ")}`);
  return parts.join(" — ");
}
---

<Base title={entry.data.name} description={descriptionText()}>
  <article data-pagefind-body>
    {/* Pagefind filter metadata — hidden, enables faceted search */}
    <div style="display:none">
      <span data-pagefind-filter="kind">{entry.data.kind}</span>
      {entry.data.source_frame && <span data-pagefind-filter="frame">{entry.data.source_frame}</span>}
      {ep.map((v: string) => <span data-pagefind-filter="pattern">{v}</span>)}
      {rt.map((v: string) => <span data-pagefind-filter="relation">{v}</span>)}
      {stList.map((v: string) => <span data-pagefind-filter="structure">{v}</span>)}
      {al && <span data-pagefind-filter="level">{al}</span>}
    </div>

    <h1>{entry.data.name}</h1>

    <p class="muted">
      <span class="tag">{entry.data.kind}</span>
      {entry.data.dead && <span class="tag">dead</span>}
      {entry.data.grounding && <span class="tag">{entry.data.grounding}</span>}
    </p>

    {(sourceFrame || appliesTo.length > 0) && (
      <p class="muted">
        {sourceFrame && (
          <>
            Source: <a href={`/frames/${sourceFrame.data.slug}/`}>{sourceFrame.data.name}</a>
          </>
        )}
        {sourceFrame && appliesTo.length > 0 && " → "}
        {appliesTo.length > 0 && (
          <>
            {!sourceFrame && "Applies to: "}
            {appliesTo.map((a: { slug: string; frame: any }, i: number) => (
              <>
                {i > 0 && ", "}
                {a.frame
                  ? <a href={`/frames/${a.frame.data.slug}/`}>{a.frame.data.name}</a>
                  : a.slug}
              </>
            ))}
          </>
        )}
      </p>
    )}

    <p class="muted">
      Categories: {entry.data.categories.map((c: string) => (
        <a href={`/categories/${c}/`} class="tag">{c}</a>
      ))}
    </p>

    {provenanceWork && (
      <p class="muted">
        From: <a href={`/works/${provenanceWork.data.slug}/`}>{provenanceWork.data.name}</a>
      </p>
    )}

    <Content />

    {related.length > 0 && (
      <>
        <h2>Related Entries</h2>
        <ul>
          {related.map((r: any) => (
            <li><a href={`/entries/${r.data.slug}/`}>{r.data.name}</a></li>
          ))}
        </ul>
      </>
    )}

    {crossDomain.length > 0 && (
      <>
        <h2>Structural Neighbors</h2>
        <p class="muted">Entries from different domains that share structural shape.
          Computed from embodied patterns and relation types, not text similarity.</p>
        <ul class="neighbors">
          {crossDomain.map((n: any) => (
            <li>
              <a href={`/entries/${n.slug}/`}>{n.name}</a>
              <span class="muted"> ({n.sourceFrame}/{n.kind})</span>
              {n.sharedEp.length > 0 && (
                <span class="muted neighbor-tags">
                  {" "}{n.sharedEp.concat(n.sharedRt).join(", ")}
                </span>
              )}
            </li>
          ))}
        </ul>
      </>
    )}

    {ep.length > 0 && (
      <>
        <h2>Structural Tags</h2>
        <p class="muted">
          Patterns: {ep.map((v: string) => <span class="tag">{v}</span>)}
        </p>
        <p class="muted">
          Relations: {rt.map((v: string) => <span class="tag">{v}</span>)}
        </p>
        <p class="muted">
          Structure: {stList.map((v: string) => <span class="tag">{v}</span>)}
          {al && <>{" "}Level: <span class="tag">{al}</span></>}
        </p>
      </>
    )}

    {(() => {
      const contributors = [
        ...(entry.data.author.startsWith("agent:")
          ? [{ label: entry.data.author, href: `/agents#${entry.data.author.replace("agent:metaphorex-", "")}` }]
          : [{ label: entry.data.author }]),
        ...(entry.data.contributors || []).map((c: string) => ({ label: c })),
      ];
      return contributors.length > 0 && (
        <p class="muted">
          Contributors: {contributors.map((c: { label: string; href?: string }, i: number) => (
            <>{i > 0 && ", "}{c.href ? <a href={c.href}>{c.label}</a> : c.label}</>
          ))}
        </p>
      );
    })()}
  </article>
</Base>
