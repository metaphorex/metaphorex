---
import Base from "@/layouts/Base.astro";
import { getCollection, render } from "astro:content";
import neighborsData from "@/data/neighbors.json";

export async function getStaticPaths() {
  const entries = await getCollection("entries");
  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const allFrames = await getCollection("frames");
const sourceFrame = entry.data.source_frame
  ? allFrames.find((f) => f.data.slug === entry.data.source_frame)
  : null;
const appliesTo = (entry.data.applies_to || []).map((slug: string) => {
  const frame = allFrames.find((f) => f.data.slug === slug);
  return { slug, frame };
});
const allEntries = await getCollection("entries");
const related = entry.data.related
  .map((slug: string) => allEntries.find((m) => m.data.slug === slug))
  .filter(Boolean);

const entryNeighbors = (neighborsData as any)[entry.data.slug];
const crossDomain = (entryNeighbors?.crossDomain ?? []).slice(0, 5);

const ep = entry.data.embodied_patterns ?? [];
const rt = entry.data.relation_types ?? [];
const st = entry.data.structure;
const stList = st ? (Array.isArray(st) ? st : [st]) : [];
const al = entry.data.abstraction_level;
const transfers = entry.data.transfers ?? [];
const limits = entry.data.limits ?? [];
const summary = (entry.data as any).summary as string | undefined;

// Extract expressions from rendered content (first few)
const allWorks = await getCollection("works");
const provenanceWork = entry.data.provenance
  ? allWorks.find((w) => w.data.slug === entry.data.provenance)
  : null;

function stripPrefix(s: string): string {
  return s.replace(/^\[.*?\]\s*/, "");
}
---

<Base title={`${entry.data.name} — Layout B`}>
  <p class="muted" style="margin-bottom:1rem; font-size:0.85em">
    <a href="/mockup/">Mockups</a> &middot; Layout B: Card &middot;
    <a href={`/mockup/a/${entry.data.slug}/`}>A</a> &middot;
    <a href={`/mockup/c/${entry.data.slug}/`}>C</a> &middot;
    <a href={`/entries/${entry.data.slug}/`}>Current</a>
  </p>

  <style>
    .card {
      border: 1px solid var(--border);
      border-radius: 0.5rem;
      overflow: hidden;
    }
    .card-header {
      padding: 1rem 1.25rem 0.75rem;
      border-bottom: 1px solid var(--border);
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .card-header h1 {
      font-size: 1.4em;
      margin: 0;
    }
    .card-header .meta {
      font-size: 0.85em;
      color: var(--muted);
      font-family: var(--font-heading);
    }
    .card-summary {
      padding: 0.5rem 1.25rem 0.75rem;
      font-size: 1em;
      line-height: 1.4;
      color: var(--fg);
    }
    .card-summary.placeholder {
      color: var(--muted);
      font-style: italic;
      font-size: 0.9em;
    }
    .card-mapping {
      padding: 0.25rem 1.25rem 0.5rem;
      font-size: 0.85em;
      color: var(--muted);
      border-bottom: 1px solid var(--border);
    }
    .two-col {
      display: grid;
      grid-template-columns: 1fr 1fr;
      min-height: 0;
    }
    @media (max-width: 600px) {
      .two-col { grid-template-columns: 1fr; }
    }
    .col-transfers {
      padding: 1rem 1.25rem;
      border-right: 1px solid var(--border);
    }
    .col-limits {
      padding: 1rem 1.25rem;
    }
    .col-transfers h2, .col-limits h2 {
      font-size: 0.75em;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--muted);
      margin: 0 0 0.75rem;
      border: none;
      padding: 0;
    }
    .prop-list {
      list-style: none;
      margin: 0;
      padding: 0;
      font-size: 0.92em;
      line-height: 1.45;
    }
    .prop-list li {
      margin-bottom: 0.6rem;
      padding-left: 1.2em;
      text-indent: -1.2em;
    }
    .prop-list .t::before { content: "◆ "; color: var(--accent); }
    .prop-list .l::before { content: "✕ "; color: #c44; }
    .card-section {
      padding: 0.75rem 1.25rem;
      border-top: 1px solid var(--border);
      font-size: 0.9em;
    }
    .card-section h2 {
      font-size: 0.75em;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--muted);
      margin: 0 0 0.4rem;
      border: none;
      padding: 0;
    }
    .neighbors-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.25rem 1rem;
      font-size: 0.9em;
    }
    @media (max-width: 600px) {
      .neighbors-grid { grid-template-columns: 1fr; }
    }
    .neighbors-grid a { font-weight: 600; }
    .neighbors-grid .n-meta {
      color: var(--muted);
      font-size: 0.85em;
    }
    .tag-bar {
      padding: 0.5rem 1.25rem;
      border-top: 1px solid var(--border);
      background: var(--surface);
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 1.5rem;
      font-size: 0.8em;
      color: var(--muted);
      font-family: var(--font-heading);
    }
    .tag-bar .tag { font-size: 0.85em; }
    .card-section .expr {
      font-style: italic;
      color: var(--muted);
    }
    details.card-details summary {
      cursor: pointer;
      font-family: var(--font-heading);
      font-size: 0.85em;
      color: var(--muted);
      padding: 0.5rem 1.25rem;
      border-top: 1px solid var(--border);
    }
    details.card-details summary:hover { color: var(--fg); }
    details.card-details > div {
      padding: 0 1.25rem 1rem;
      font-size: 0.92em;
    }
  </style>

  <div class="card">
    <div class="card-header">
      <h1>{entry.data.name}</h1>
      <span class="meta">
        <span class="tag">{entry.data.kind}</span>
        {entry.data.dead && <span class="tag">dead</span>}
        {al && <span class="tag">{al}</span>}
      </span>
    </div>

    {summary ? (
      <p class="card-summary">{summary}</p>
    ) : (
      <p class="card-summary placeholder">[ needs summary ]</p>
    )}

    {(sourceFrame || appliesTo.length > 0) && (
      <div class="card-mapping">
        {sourceFrame && (
          <a href={`/frames/${sourceFrame.data.slug}/`}>{sourceFrame.data.name}</a>
        )}
        {sourceFrame && appliesTo.length > 0 && " → "}
        {appliesTo.map((a: { slug: string; frame: any }, i: number) => (
          <>
            {i > 0 && ", "}
            {a.frame
              ? <a href={`/frames/${a.frame.data.slug}/`}>{a.frame.data.name}</a>
              : a.slug}
          </>
        ))}
      </div>
    )}

    {(transfers.length > 0 || limits.length > 0) && (
      <div class="two-col">
        <div class="col-transfers">
          <h2>Transfers</h2>
          <ul class="prop-list">
            {transfers.map((t: string) => (
              <li class="t">{stripPrefix(t)}</li>
            ))}
          </ul>
        </div>
        <div class="col-limits">
          <h2>Limits</h2>
          <ul class="prop-list">
            {limits.map((l: string) => (
              <li class="l">{stripPrefix(l)}</li>
            ))}
          </ul>
        </div>
      </div>
    )}

    {crossDomain.length > 0 && (
      <div class="card-section">
        <h2>Structural neighbors</h2>
        <div class="neighbors-grid">
          {crossDomain.map((n: any) => (
            <div>
              <a href={`/entries/${n.slug}/`}>{n.name}</a>
              <span class="n-meta"> {n.sourceFrame} &middot; {n.sharedEp.slice(0,2).concat(n.sharedRt.slice(0,1)).join(", ")}</span>
            </div>
          ))}
          {related.length > 0 && related.slice(0, 3).map((r: any) => (
            <div>
              <a href={`/entries/${r.data.slug}/`}>{r.data.name}</a>
              <span class="n-meta"> related</span>
            </div>
          ))}
        </div>
      </div>
    )}

    <details class="card-details">
      <summary>Full commentary & expressions</summary>
      <div>
        <Content />
      </div>
    </details>

    <div class="tag-bar">
      {ep.length > 0 && <span>
        {ep.map((v: string) => <span class="tag">{v}</span>)}
      </span>}
      {rt.length > 0 && <span>
        {rt.map((v: string) => <span class="tag">{v}</span>)}
      </span>}
      {stList.length > 0 && <span>
        {stList.map((v: string) => <span class="tag">{v}</span>)}
      </span>}
    </div>
  </div>
</Base>
