---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "A materials library of load-bearing metaphors and other useful abstractions" } = Astro.props;
const corpusVersion = new Date().toISOString().split("T")[0].replace(/-/g, ".");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} | Metaphorex</title>

    <!-- Fonts: Source Serif 4 (body), Source Sans 3 (headings/UI), IBM Plex Mono (code) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&family=Source+Sans+3:wght@400;600&family=IBM+Plex+Mono:ital,wght@0,400;1,400&display=swap" rel="stylesheet" />

    <style is:global>

      /* =========================================================
         DESIGN TOKENS
         ========================================================= */

      :root {
        --max-width: 42rem;
        --font-body: "Source Serif 4", Charter, "Bitstream Charter", Georgia, serif;
        --font-heading: "Source Sans 3", system-ui, -apple-system, sans-serif;
        --font-mono: "IBM Plex Mono", SFMono-Regular, Consolas, monospace;
        --font-size: 1.1875rem;
        --line-height: 1.58;
        --bg: #fff;
        --fg: #1a1a1a;
        --muted: #555;
        --border: #ccc;
        --accent: #36c;
        --accent-hover: #5588cc;
        --surface: #f8f8f8;
        --tag-bg: #eee;
        --tag-fg: #444;
        /* Pagefind */
        --pagefind-ui-font: "Source Sans 3", system-ui, sans-serif;
        --pagefind-ui-primary: var(--accent);
        --pagefind-ui-border: var(--border);
        --pagefind-ui-background: var(--bg);
      }

      /* =========================================================
         RESET
         ========================================================= */

      *, *::before, *::after {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      /* =========================================================
         BASE STRUCTURE
         ========================================================= */

      body {
        font-family: var(--font-body);
        font-size: var(--font-size);
        color: var(--fg);
        background: var(--bg);
        line-height: var(--line-height);
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 2.5rem 2rem 3rem;
      }

      /* =========================================================
         TYPOGRAPHY
         ========================================================= */

      h1, h2, h3, h4 {
        font-family: var(--font-heading);
        font-weight: 600;
      }

      h1 {
        font-size: 1.5em;
        margin-bottom: 0.5rem;
        line-height: 1.25;
      }

      h2 {
        font-size: 1.2em;
        margin: 1.5rem 0 0.5rem;
        line-height: 1.3;
      }

      h3 {
        font-size: 1.05em;
        margin: 1.25rem 0 0.25rem;
        line-height: 1.35;
      }

      p {
        margin-bottom: 1rem;
      }

      code, pre {
        font-family: var(--font-mono);
        font-size: 0.875em;
      }

      code {
        background: var(--surface);
        padding: 0.1em 0.35em;
        border-radius: 0.2em;
      }

      pre {
        background: var(--surface);
        padding: 1rem;
        border-radius: 0.3rem;
        overflow-x: auto;
        margin-bottom: 1rem;
      }

      pre code {
        background: none;
        padding: 0;
      }

      /* =========================================================
         LINKS
         ========================================================= */

      a {
        color: var(--accent);
        text-decoration: none;
        text-underline-offset: 0.15em;
      }

      a:hover {
        color: var(--accent-hover);
        text-decoration: underline;
      }

      /* =========================================================
         NAVIGATION
         ========================================================= */

      nav {
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--border);
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.5rem 1.5rem;
      }

      @media (max-width: 640px) {
        nav {
          display: grid;
          grid-template-columns: 1fr auto;
          grid-template-rows: auto auto;
          gap: 0.4rem 0;
          align-items: baseline;
        }
        nav .site-name {
          grid-column: 1;
          grid-row: 1;
        }
        nav .nav-overflow {
          grid-column: 2;
          grid-row: 1;
          justify-self: end;
        }
        nav .nav-links {
          grid-column: 1 / -1;
          grid-row: 2;
        }
      }

      .site-name {
        font-family: var(--font-heading);
        font-weight: 700;
        color: var(--fg);
      }

      .site-name:hover {
        color: var(--fg);
      }

      .nav-links {
        display: flex;
        flex-wrap: wrap;
        gap: 0 1.5rem;
        font-family: var(--font-heading);
        font-size: 0.9375em;
      }

      .nav-overflow { display: none; }

      @media (max-width: 640px) {
        .nav-links .nav-collapsible { display: none; }
        .nav-overflow {
          display: inline-block;
          position: relative;
          font-family: var(--font-heading);
          font-size: 0.9375em;
        }
        .nav-overflow summary {
          cursor: pointer;
          list-style: none;
          color: var(--accent);
          font-weight: 600;
          letter-spacing: 0.1em;
        }
        .nav-overflow summary::-webkit-details-marker { display: none; }
        .nav-overflow .nav-dropdown {
          position: absolute;
          right: 0;
          top: 1.5em;
          background: var(--bg);
          border: 1px solid var(--border);
          border-radius: 0.3rem;
          padding: 0.5rem 0;
          min-width: 8rem;
          box-shadow: 0 2px 8px rgba(0,0,0,0.1);
          z-index: 10;
        }
        .nav-overflow .nav-dropdown a {
          display: block;
          padding: 0.35rem 1rem;
          white-space: nowrap;
        }
        .nav-overflow .nav-dropdown a:hover {
          background: var(--surface);
        }
      }

      /* =========================================================
         COMPONENTS
         ========================================================= */

      .tag {
        display: inline-block;
        font-family: var(--font-heading);
        font-variant: small-caps;
        text-transform: lowercase;
        letter-spacing: 0.03em;
        font-size: 0.8em;
        padding: 0.125em 0.5em;
        background: var(--tag-bg);
        color: var(--tag-fg);
        border-radius: 0.2em;
        margin: 0.125em 0.25em;
        line-height: 1.6;
      }

      .muted {
        color: var(--muted);
      }

      .entry-list {
        list-style: none;
      }

      .entry-list li {
        padding: 0.5rem 0;
        border-bottom: 1px solid var(--border);
      }

      .entry-list li:last-child {
        border-bottom: none;
      }

      /* =========================================================
         BLOCKQUOTES
         ========================================================= */

      blockquote {
        margin: 1rem 0;
        padding: 0.75rem 1rem;
        border-left: 3px solid var(--border);
        background: var(--surface);
      }

      /* =========================================================
         ARTICLE (entry detail pages)
         ========================================================= */

      article {
        line-height: var(--line-height);
      }

      article h2 {
        margin-top: 2rem;
        border-bottom: 1px solid var(--border);
        padding-bottom: 0.2em;
      }

      article ul, article ol {
        margin-left: 1.5rem;
        margin-bottom: 1rem;
      }

      article p {
        margin-bottom: 1rem;
      }

      article li {
        margin-bottom: 0.25rem;
      }

      /* =========================================================
         SEARCH (Pagefind overrides)
         ========================================================= */

      #search {
        margin-bottom: 1.5rem;
      }

      .pagefind-ui__search-input {
        font-family: var(--font-heading) !important;
        font-size: 0.9375rem !important;
        background: var(--surface) !important;
        border: 1px solid var(--border) !important;
        border-radius: 0.25rem !important;
        color: var(--fg) !important;
      }

      /* =========================================================
         FOOTER
         ========================================================= */

      footer {
        margin-top: 3rem;
        padding-top: 1rem;
        border-top: 1px solid var(--border);
        color: var(--muted);
        font-size: 0.8125rem;
        font-family: var(--font-heading);
      }

      /* =========================================================
         RESPONSIVE
         ========================================================= */

      @media (max-width: 640px) {
        body {
          padding: 1.5rem 1.25rem 2.5rem;
          font-size: calc(var(--font-size) - 0.0625rem);
        }

        h1 { font-size: 1.3em; }
        h2 { font-size: 1.1em; }

        nav {
          gap: 0.375rem 1rem;
        }
      }

    </style>
    <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
    <script src="/pagefind/pagefind-ui.js" is:inline></script>
  </head>
  <body>
    <nav>
      <a href="/" class="site-name">Metaphorex</a>
      <span class="nav-links">
        <a href="/entries/">Entries</a>
        <a href="/frames/">Frames</a>
        <a href="/categories/">Categories</a>
        <a href="/works/" class="nav-collapsible">Works</a>
        <a href="/about/" class="nav-collapsible">About</a>
        <a href="https://github.com/metaphorex/metaphorex" class="nav-collapsible" title="GitHub" aria-label="GitHub"><svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" style="vertical-align: -0.2em;"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg></a>
      </span>
      <details class="nav-overflow">
        <summary>&middot;&middot;&middot;</summary>
        <div class="nav-dropdown">
          <a href="/works/">Works</a>
          <a href="/about/">About</a>
          <a href="https://github.com/metaphorex/metaphorex">GitHub</a>
        </div>
      </details>
    </nav>
    <div id="search"></div>
    <script is:inline>
      new PagefindUI({
        element: "#search",
        showSubResults: true,
        showEmptyFilters: false,
      });
    </script>
    <slot />
    <footer>
      Metaphorex {corpusVersion} &middot;
      <a href="https://github.com/metaphorex/metaphorex">GitHub</a> &middot;
      <a href="/devlog/">Devlog</a> &middot;
      <a href="/ops/">Ops</a> &middot;
      CC BY-SA 4.0
    </footer>
  </body>
</html>
